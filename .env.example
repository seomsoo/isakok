# Supabase — 로컬 개발은 항상 dev(isakok-dev) (스펙 14 §5-3). prod 키는 로컬에 두지 않는다(§6-4).
# 변수명은 코드 호환용 — 실값은 legacy JWT가 아니라 sb_publishable_*(클라이언트)/sb_secret_*(서버) (ADR-075).
# 파일 역할 분리: apps/web/.env.local = 웹 클라이언트(VITE_*) / 루트 .env.local = 스크립트 전용(아래 스크립트 섹션).
VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-publishable-key

# 관측 레이어 (스펙 11 — Observability). 미설정 시 해당 SDK는 조용히 비활성.
# 환경 판정 1순위. Vercel deployment별 명시: production / development
VITE_APP_ENV=development
# Sentry (웹 에러 추적). 환경별 DSN.
VITE_SENTRY_DSN=
# Sentry release. Vercel build env에서 isakok-web@$VERCEL_GIT_COMMIT_SHA로 주입(소스맵 업로드와 동일값).
VITE_SENTRY_RELEASE=
# PostHog 프로젝트 키. dev/prod 별도 프로젝트 키(US 리전).
VITE_POSTHOG_KEY=

# --- 빌드 전용 시크릿(클라이언트 미노출 — Vercel build env에만) ---
# Sentry 소스맵 업로드. 설정돼 있을 때만 vite build가 소스맵을 생성·업로드·삭제한다.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- 스크립트 전용(루트 .env.local — rls-smoke 등 수동 실행 시 source) ---
# 전부 dev 값. SERVICE_ROLE_KEY(=sb_secret_*)는 필요할 때 dev 대시보드에서 복사해 쓰고 비워둔다.
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your-dev-publishable-key
SUPABASE_SERVICE_ROLE_KEY=
